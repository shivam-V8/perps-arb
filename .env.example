# ── apps/web (put real values in apps/web/.env.local) ─────────────
# Base URL of the FastAPI ingest service
INGEST_API_URL=http://localhost:8100
# Supabase project (server-side only — service role key must never be NEXT_PUBLIC)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string used to hash IPs for waitlist rate limiting
WAITLIST_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── services/ingest (Fly secrets in prod; compose sets these locally) ──
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000
# Optional overrides
# POLL_INTERVAL_S=30
# STALE_AFTER_S=180
# MIN_SPREAD_OI_USD=250000
