{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chainmatch",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Production now runs on AWS (scripts/deploy-aws.sh); this Worker only keeps its workers.dev URL as a fallback.
  "workers_dev": true,
  "triggers": { "crons": [] },
  // Postgres (Neon) through Hyperdrive (pooled connections close to the database).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "21601a901f794e3f90bcd06ed30b1ca7", "localConnectionString": "postgres://chainmatch:chainmatch@localhost:5433/chainmatch" }],
  // Secrets (set with `wrangler secret put`): ANTHROPIC_API_KEY, FIRECRAWL_API_KEY, SESSION_SECRET, DATABASE_URL.
  "vars": {}
}
