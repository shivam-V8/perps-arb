{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chainmatch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Production domains (Workers custom domains; DNS + certificates managed by Cloudflare).
  "workers_dev": true,
  "routes": [{ "pattern": "chainmatch.ai", "custom_domain": true }],
  // Postgres (Neon) through Hyperdrive (pooled connections close to the database).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "21601a901f794e3f90bcd06ed30b1ca7", "localConnectionString": "postgres://chainmatch:chainmatch@localhost:5433/chainmatch" }],
  // Secrets (set with `wrangler secret put`): ANTHROPIC_API_KEY, FIRECRAWL_API_KEY, SESSION_SECRET, DATABASE_URL.
  "vars": {}
}
