# Postgres. Local: `docker compose up -d db` (from the repo root). Production: any hosted Postgres, e.g. Neon.
DATABASE_URL=postgres://chainmatch:chainmatch@localhost:5433/chainmatch

# Signs the anonymous identity cookie. Required in production (32+ random chars): openssl rand -base64 48
SESSION_SECRET=

# Claude: résumé parsing, live job search (web search), ranking, cover notes, chat suggestions
ANTHROPIC_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: automatic LinkedIn import from a profile URL (Firecrawl provider data, FullEnrich people/match).
# Without it, the link lookup uses public web search, then offers copy-paste / LinkedIn export.
FIRECRAWL_API_KEY=

# Optional: rate limits are off in development; set to 1 to test them. Per-hour limits can be overridden:
# ENFORCE_QUOTAS=1
# QUOTA_LINKEDIN_PER_HOUR=10
